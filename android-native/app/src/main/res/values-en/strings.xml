    <!-- Addons screen: descriptive copy that used to be hardcoded in Kotlin. -->
    <string name="addons_intro">Paste the manifest URL of a Stremio addon. That is where sources and subtitles come from — the app never shows you the list of links, it just uses the best one that opens.</string>
    <string name="addons_quick_opensubtitles_what">Subtitles in dozens of languages, already indexed by IMDb ID.</string>
    <string name="addons_quick_aiostreams_what">Merges several source addons into one, deduplicates and reorders the results. The manifest URL is generated per user in its configuration page.</string>
    <string name="addons_quick_aiostreams_unconfigured">only works through the generated URL</string>
    <string name="addons_stremio_import_explainer">The whole collection arrives with its configured URLs and debrid keys. The password goes straight to api.strem.io and is never saved; only the session key Stremio returns stays on this device.</string>
    <string name="addons_mdblist_catalog_explainer">The lists will be downloaded from MDBList and installed as local addons in OmniStream.</string>
    <string name="addons_sync_explainer">List names, order, visibility and deletions follow your Google account automatically. This button controls addon syncing: turn it on for both devices so they follow along too, without needing a Stremio account.</string>
    <string name="addons_preferences_error">Names, order, hidden and deleted items are still only on this device. %1$s</string>
    <string name="addons_delta_changed">List updated — %1$d addon(s) of difference.</string>
    <string name="addons_delta_unchanged">Nothing changed — this device was already up to date.</string>

