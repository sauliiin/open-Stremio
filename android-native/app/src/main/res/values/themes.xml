<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose draws everything, so the platform theme only has to keep the
        window from flashing white before the first frame and hand the whole
        screen over to the app.
    -->
    <style name="Theme.MdblistHub" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/hub_background</item>
        <item name="android:colorBackground">@color/hub_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
